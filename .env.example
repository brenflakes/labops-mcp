# Homelab MCP Environment Variables
#
# Copy this to .env and fill in your tokens.
# Never commit .env to version control!

# =============================================================================
# MONITORING
# =============================================================================

# Grafana: Settings → Service Accounts → Add token
GRAFANA_TOKEN=

# Uptime Kuma: Format is username:password (for basic auth on /metrics endpoint)
# Enable metrics: Settings → General → Prometheus Metrics
KUMA_TOKEN=admin:yourpassword

# =============================================================================
# MEDIA (*arr stack)
# =============================================================================

# Sonarr: Settings → General → API Key
SONARR_TOKEN=

# Radarr: Settings → General → API Key
RADARR_TOKEN=

# Prowlarr: Settings → General → API Key
PROWLARR_TOKEN=

# Jellyfin: Dashboard → API Keys → Add
JELLYFIN_TOKEN=

# =============================================================================
# PHOTOS
# =============================================================================

# Immich: Account Settings → API Keys → New
IMMICH_TOKEN=

# =============================================================================
# INFRASTRUCTURE
# =============================================================================

# Portainer: Account → Access tokens → Add
PORTAINER_TOKEN=

# Home Assistant: Profile → Security → Long-lived access tokens
HA_TOKEN=

# Proxmox: Datacenter → Permissions → API Tokens
# Format: user@realm!tokenid=token-uuid
PROXMOX_TOKEN=

# =============================================================================
# NAS
# =============================================================================

# Synology DSM: Create a dedicated user (e.g., labops) with read-only admin access
# Disable 2FA for this user. Format: username:password
SYNOLOGY_CREDS=labops:yourpassword

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Optional: Bearer token for MCP authentication
# Generate with: openssl rand -hex 32
# Leave empty to disable auth (not recommended for production)
MCP_AUTH_TOKEN=
